daftar_klinik=[{"Kode":"K1","klinik":"Klinik Psikiatri","deskripsi":"memiliki 3 klinik psikiatri yaitu Klinik Psikiatri I, Klinik Psikiatri II dan KLinik Psikiatri III : Ketergantungan Obat, Gangguan Tidur, Hiperaktif, Autisme, Depresi, Schizofrenia, Bipolar"},{"Kode":"K2","klinik":"Klinik Psikologi","deskripsi":"layanan profesional untuk menangani masalah kesehatan mental dan emosional, seperti depresi, kecemasan, stres, dan gangguan perilaku, melalui konsultasi, asesmen (tes psikologi), konseling, serta berbagai bentuk terapi psikologis seperti Terapi Perilaku Kognitif (CBT)"},{"Kode":"K3","klinik":"Klinik Spiritual","deskripsi":"layanan yang menyediakan dukungan, bimbingan, dan terapi untuk memenuhi kebutuhan spiritual : Ruqiyah Syar'iyah / Terapi Al Quran, Bimbingan Ibadah, Konseling"},{"Kode":"K4","klinik":"Rehabilitasi Psikososial","deskripsi":"pelayanan komprehensif bagi pasien gangguan jiwa yang bertujuan membantu agar pasien dapat memenuhi kebutuhannya dan pemulihan penyakit yang berfokus pada kemampuan untukmenggunakan strategi mengatasi masalah atau penyakit serta membangun hubungan sosial, kemungkinan untuk dapat bekerja kembali di masyarakat."},{"Kode":"K5","klinik":"Klinik Tumbuh Kembang Anak","deskripsi":" layanan penanganan berbagai masalah tumbuh kembang anak : perubahan konsentrasi, komunikasi hingga kemampuan belajar"}]