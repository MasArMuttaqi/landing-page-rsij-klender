var daftar_klinik = [{"Kode":"K1","klinik":"Klinik Psikiatri","deskripsi":"memiliki 3 klinik psikiatri yaitu Klinik Psikiatri I, Klinik Psikiatri II dan Klinik Psikiatri III : Ketergantungan Obat, Gangguan Tidur, Hiperaktif, Autisme, Depresi, Schizofrenia, Bipolar dan gangguan psikologis yang membutuhkan penanganan medis.","icon":"https://d1e8la4lqf1h28.cloudfront.net/images/76995b0a-276f-4341-93d5-9bd7544df798_category_image_url.webp"},{"Kode":"K3","klinik":"Klinik Psikologi Klinis","deskripsi":"Layanan profesional untuk menangani masalah kesehatan mental dan emosional, seperti: depresi, kecemasan, stres, dan gangguan perilaku, melalui konsultasi, asesmen (tes psikologi), konseling, serta berbagai bentuk terapi psikologis seperti Terapi Perilaku Kognitif (CBT)","icon":"https://d1e8la4lqf1h28.cloudfront.net/images/65cc3d18-0174-4c61-aa2a-b4645ce29206_category_image_url.webp"},{"Kode":"K6","klinik":"Terapi Spiritual","deskripsi":"Layanan yang menyediakan dukungan, bimbingan, dan terapi untuk memenuhi kebutuhan spiritual : Ruqiyah Syar'iyah / Terapi Al Quran, Bimbingan Ibadah, dan Konseling","icon":"https://i.pinimg.com/736x/5b/c6/50/5bc650acb259f8eb5d1cfe2646b2f8a0.jpg"},{"Kode":"K4","klinik":"Rehabilitasi Psikososial","deskripsi":"Pelayanan komprehensif bagi pasien gangguan jiwa yang bertujuan membantu agar pasien dapat memenuhi kebutuhannya dan pemulihan penyakit yang berfokus pada kemampuan untukmenggunakan strategi mengatasi masalah atau penyakit serta membangun hubungan sosial, kemungkinan untuk dapat bekerja kembali di masyarakat.","icon":"https://d2qjkwm11akmwu.cloudfront.net/images/270386_12-9-2022_14-32-7.webp"},{"Kode":"K5","klinik":"Klinik Tumbuh Kembang Anak","deskripsi":"Pelayanan penanganan berbagai masalah tumbuh kembang anak : perubahan konsentrasi, komunikasi hingga kemampuan belajar","icon":"https://d2qjkwm11akmwu.cloudfront.net/images/765003_16-9-2022_15-19-2.webp"},{"Kode":"K2","klinik":"Klinik Umum","deskripsi":"pelayanan kesehatan yang memberikan pelayanan medis dasar, kegawatdaruratan dan komprehensif kepada pasien dari berbagai kelompok usia, mulai dari anak, dewasa, hingga lanjut usia. Pelayanan dilaksanakan secara promotif, preventif, kuratif, dan rehabilitatif sesuai dengan standar pelayanan medis yang berlaku.","icon":"https://d1e8la4lqf1h28.cloudfront.net/images/d8b7c9e4-bc99-4297-ac15-44a3a51d16a3_category_image_url.webp"}]